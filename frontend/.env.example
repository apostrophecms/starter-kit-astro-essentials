# Astro Frontend Environment Variables
# Copy this file to .env and fill in your values.

# Required for local development — must match APOS_EXTERNAL_FRONT_KEY in the backend .env.
APOS_EXTERNAL_FRONT_KEY=dev

# Port for the Astro dev/preview server (default: 4321).
# PORT=4321

# Comma-separated public hostnames the production site is served from
# (defaults to **.apos.dev for ApostropheCMS hosting). A bare hostname means
# https; use a full origin like http://staging.example.com:4321 otherwise.
# Needed for logout and uploads on some hosts and for a correct Astro.url
# behind a proxy. Read at build time.
# APOS_ALLOWED_DOMAINS=www.example.com,example.com
