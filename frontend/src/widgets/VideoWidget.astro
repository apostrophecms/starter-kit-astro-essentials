---
// aposFetch is a server-side-only wrapper around fetch that resolves relative
// /api/v1/... paths against the ApostropheCMS backend host. Never import it
// into client-side code. The bare "/helpers" path is deprecated as of 1.15.0
// in favour of the scoped "/helpers/server" subpath used here.
import { aposFetch } from "@apostrophecms/apostrophe-astro/helpers/server";

const { widget } = Astro.props;
const placeholder = widget?.aposPlaceholder ? "true" : "";
const url = widget?.video?.url;

// The oembed lookup runs here, on the server, rather than in the browser.
// apostrophe-astro round-trips through Astro on every edit-mode re-render, so
// data-oembed is always regenerated for the current video URL.
let oembedData = "";

const videoUrl = placeholder ? "https://youtu.be/Q5UX9yexEyM" : url;
if (videoUrl) {
  try {
    const oembedUrl =
      `/api/v1/@apostrophecms/oembed/query?` +
      new URLSearchParams({ url: videoUrl });
    const response = await aposFetch(oembedUrl);
    if (response.ok) {
      const result = await response.json();
      oembedData = JSON.stringify(result);
    }
  } catch (e) {
    // oembed fetch failed, widget will render an error message
  }
}
---

<style>
  video-widget {
    width: 100%;
  }
</style>
<video-widget url={videoUrl} data-oembed={oembedData}></video-widget>
